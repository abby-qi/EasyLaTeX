{
  "name": "easylatex",
  "version": "1.0.0",
  "description": "A visual LaTeX editor for non-technical users",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "lint": "eslint . --ext .js,.vue",
    "test": "jest"
  },
  "keywords": [
    "latex",
    "editor",
    "electron",
    "pdf"
  ],
  "author": "EasyLaTeX Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "build": {
    "appId": "com.easylatex.app",
    "productName": "EasyLaTeX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "frontend/**/*",
      "backend/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "frontend/assets/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "frontend/assets/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "frontend/assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}