{
  "name": "easylatex",
  "version": "1.0.0",
  "description": "A visual LaTeX editor for non-technical users",
  "main": "src/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "lint": "eslint . --ext .js,.vue",
    "test": "jest"
  },
  "keywords": [
    "latex",
    "editor",
    "electron",
    "pdf"
  ],
  "author": "EasyLaTeX Team",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@esbuild/win32-x64": "^0.27.2",
    "pdfjs-dist": "6.3.289",
    "vue": "^3.4.0"
  },
  "build": {
    "appId": "com.easylatex.app",
    "productName": "EasyLaTeX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/frontend/**/*",
      "src/dist/**/*",
      "src/backend/**/*",
      "src/config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/frontend/assets/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/frontend/assets/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/frontend/assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
